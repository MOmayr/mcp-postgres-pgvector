{
  "mcpServers": {
    "postgres": {
      "transport": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "--watch", "src/index.ts"],
      "env": {
        "PG_HOST": "localhost",
        "PG_PORT": "5432",
        "PG_USER": "postgres",
        "PG_PASSWORD": "postgres",
        "PG_DATABASE": "postgres"
      }
    }
  }
}
