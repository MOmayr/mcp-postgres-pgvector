{
  "name": "mcp-postgres-server",
  "version": "0.1.3",
  "description": "MCP server for PostgreSQL: SQL, schema inspection, trigram mention search, and pgvector search with embeddings",
  "author": "Umair",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-postgres": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector --config ./config-stdio.json",
    "start:http": "node build/index.js --http",
    "start": "npm run build && npm run start:http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.10.7",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
